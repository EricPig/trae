# ===========================================
# 寻味中国 · 环境变量示例
# 复制为 .env 并填入实际值
# ===========================================

# ---- 环境 ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xunwei
POSTGRES_USER=xunwei
POSTGRES_PASSWORD=change_me
POSTGRES_URL=postgresql+psycopg://xunwei:change_me@localhost:5432/xunwei

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- LLM ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_FAST_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=5000

# ---- 向量库（pgvector 复用 PostgreSQL）----
VECTOR_DIMENSION=1536
VECTOR_INDEX_TYPE=ivfflat

# ---- 安全 ----
# HMAC 方案三选一（ADR-002 待补充）
HMAC_SCHEME=
HMAC_SECRET=
DATA_ENCRYPTION_KEY=

# ---- 缓存 ----
CACHE_TTL_CONSTRAINT_SEC=300       # 约束提取缓存 TTL 5 分钟
CACHE_TTL_RECOMMENDATION_SEC=600    # 推荐结果缓存 TTL 10 分钟
CACHE_TTL_EVIDENCE_SEC=3600         # RAG 证据缓存 TTL 1 小时

# ---- 延迟预算 ----
RECOMMENDATION_TIMEOUT_MS=500       # 推荐引擎 500ms
LLM_CONSTRAINT_TIMEOUT_MS=200       # Layer 1 约束提取 200ms
LLM_FORMAT_TIMEOUT_MS=200           # Layer 5 格式化 200ms
RAG_TIMEOUT_MS=200                  # Layer 3 RAG 检索 200ms
SAFETY_FILTER_TIMEOUT_MS=50         # Layer 4 诚实层 50ms

# ---- 红线（架构常量，请勿修改）----
# 这些值是架构级不变量，修改需要架构师审批
MAX_LLM_CONVERGENCE_ROUNDS=4        # AI 对话收敛 ≤ 4 轮
MIN_GATE5_UNDERSTANDING=80          # Gate 5 理解度 ≥ 80%
SAFETY_VIOLATION_THRESHOLD=0        # 过敏原违反率 = 0%
HALLUCINATION_THRESHOLD=0           # 门店事实幻觉率 = 0%

# ---- 观察者 ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=xunwei-china
